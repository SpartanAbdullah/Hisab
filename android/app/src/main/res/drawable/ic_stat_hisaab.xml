<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification glyph: the Hisaab "h" mark (public/favicon.svg,
     same paths and the same 1.08696 optical scale about the centre), drawn
     white-on-transparent. Android tints small icons and ignores colour, so
     this must be a silhouette — never the mint launcher square. The tint
     colour comes from LocalNotifications.iconColor (capacitor.config.ts) for
     local notifications and from default_notification_color (AndroidManifest)
     for FCM pushes. Used by: FCM (payload icon + manifest default),
     instantNotify.ts, notificationScheduler.ts.

     History: until 2026-09-05 this file held a generic bell outline, so every
     tray notification showed a bell in the status bar while the expanded
     entry showed the launcher icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
  <group
      android:scaleX="1.08696"
      android:scaleY="1.08696"
      android:pivotX="50"
      android:pivotY="50">
    <!-- The "h": vertical stem plus the arch. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M36,26 V74 M36,56 C36,42 64,42 64,54 V74"/>
    <!-- The tilde over the arch. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M55,27 Q61,34 67,27"/>
  </group>
</vector>

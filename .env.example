VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_PUBLIC_APP_URL=https://usehisaab.com

# Optional. If set, Sentry is initialised at app boot and unhandled errors
# (window.onerror, unhandledrejection, React ErrorBoundary) are reported.
# Get one at https://sentry.io → create project → Browser JavaScript.
VITE_SENTRY_DSN=https://cec5f4a4469b26af131ec906954394c8@o4511619171680256.ingest.de.sentry.io/4511619187736656
# Optional. Enables the offline outbox runner (currently a SCAFFOLD —
# dispatch handlers throw). Leave unset until the per-store rewire is done.
VITE_ENABLE_OUTBOX=

# ── Product telemetry (PostHog, EU Cloud) ───────────────────────────────────
# Optional and EMPTY BY DEFAULT. With no key, src/lib/telemetry.ts is a total
# no-op: the SDK is never downloaded and no request is ever made. Even WITH a
# key, nothing is sent until the user turns on "Help improve Hisaab" in
# Settings — consent is device-level and defaults to OFF.
# Project key: PostHog → Project settings → Project API key (starts `phc_`).
# It is a write-only public key, not a secret, but keep this file a placeholder.
VITE_POSTHOG_KEY=
# Optional. Ingest host. Defaults to https://eu.i.posthog.com (EU residency, to
# match the Sentry EU posture). If you change this, add the new host to the
# connect-src allowlist in index.html or every event is blocked SILENTLY.
VITE_POSTHOG_HOST=

# ── In-app feedback routing (src/components/FeedbackCard.tsx) ───────────────
# Optional. WhatsApp number in international digits, no '+' or spaces
# (e.g. 923001234567). Empty = the WhatsApp button opens the contact picker
# instead of a direct chat.
VITE_FEEDBACK_WHATSAPP=
# Optional. Falls back to support@usehisaab.com when unset.
VITE_FEEDBACK_EMAIL=

# ── Server-side money engine (audit L4 pilot) ───────────────────────────────
# Optional, OFF by default. Set to exactly `true` to route the account→account
# transfer through the `transfer_between_accounts` RPC — one Postgres
# transaction for both balance legs and the transactions row, so a dropped
# connection can no longer leave money half-moved (audit MF-01 / O-1 / F-4).
# DO NOT set this until supabase-migration-p3-atomic-transfer.sql is applied to
# the project this build talks to: with the flag on and the RPC missing, every
# transfer fails with ATOMIC_TRANSFER_UNAVAILABLE (deliberately loud).
# Rollout and the plan for the remaining money branches:
# docs/server-side-money-engine.md
VITE_ATOMIC_TRANSFER=

# Step 2 of the same programme. Optional, OFF by default. Set to exactly `true`
# to route the full-tracker LOAN REPAYMENT through the `record_loan_repayment`
# RPC — one Postgres transaction for the account leg, loans.remaining_amount +
# status, the covered EMI status marks and the transactions row, so a dropped
# connection can no longer move a balance without recording it (audit MF-01 /
# F-2 / O-1 / F-4). Requires supabase-migration-p3-atomic-repayment.sql; with
# the flag on and the RPC missing every tracker repayment fails with
# ATOMIC_REPAYMENT_UNAVAILABLE (deliberately loud). Ledger-mode (splits_only)
# repayments are unaffected — they never go through this path.
VITE_ATOMIC_REPAYMENT=

# Step 3 of the same programme. Optional, OFF by default. Set to exactly `true`
# to route full-tracker LOAN CREATION (loan_given / loan_taken, including the
# credit-card cash advance) through the `create_loan_with_leg` RPC — one
# Postgres transaction for the funding/receiving balance, the cash-advance card
# balance, the loans row and the transactions row. Today a drop after the first
# leg takes money out of a wallet with NO loan saying who owes it and NO row
# saying it happened (audit MF-01 / O-1 / F-4). Requires
# supabase-migration-p3-atomic-loan-create.sql; with the flag on and the RPC
# missing every tracker loan fails with ATOMIC_LOAN_CREATE_UNAVAILABLE
# (deliberately loud). Ledger-mode (splits_only) loan creation is unaffected —
# it goes through loanStore.createLoan and never touches this path.
# Enable it only after VITE_ATOMIC_TRANSFER and VITE_ATOMIC_REPAYMENT have each
# had their own release cycle. docs/server-side-money-engine.md §12-16
VITE_ATOMIC_LOAN_CREATE=

# Step 4a. Optional, OFF by default. Set to exactly `true` to route the GOAL
# CONTRIBUTION through the `contribute_to_goal` RPC — one Postgres transaction
# for the source debit, goals.saved_amount (behind the FIRST compare-and-swap
# that column has ever had), the optional stored-in-account credit and the
# transactions row. Today leg 2 is an ABSOLUTE write with no lock, so two
# devices contributing to one goal lose a contribution outright. Requires
# supabase-migration-p3-atomic-goal-and-card.sql; with the flag on and the RPC
# missing every contribution fails with ATOMIC_GOAL_UNAVAILABLE (deliberately
# loud). splits_only has no goals at all, so it is unaffected.
# docs/server-side-money-engine.md §18-21
VITE_ATOMIC_GOAL=

# Step 4b. Optional, OFF by default. Set to exactly `true` to route the whole
# CREDIT-CARD story — paying a card bill, and repaying a cash advance that
# credits the card back — through the `pay_card_bill` RPC. The bill payment is
# the largest flow in the switch (2 balances + 1 row + N x (loan CAS + M
# instalment writes + 1 ledger row)), and a drop partway leaves a PAID bill
# whose loans still say the money is owed, so the app asks the user to pay the
# same debt twice. The allocation stays in TypeScript: the client plans, the
# server applies AND re-validates. Requires
# supabase-migration-p3-atomic-goal-and-card.sql; with the flag on and the RPC
# missing every bill payment fails with ATOMIC_CARD_BILL_UNAVAILABLE.
# Enable it AFTER VITE_ATOMIC_GOAL has had its own release cycle.
VITE_ATOMIC_CARD_BILL=

# Step 5a. Optional, OFF by default. Set to exactly `true` to route the four
# SINGLE-LEG entries — income, expense, opening_balance and adjustment —
# through the `record_single_leg_entry` RPC: one Postgres transaction for the
# balance compare-and-swap and the transactions row. This is the narrowest
# window in the engine (it cannot leave money half-moved BETWEEN two places)
# but it is the most common write in the app, and what it leaves behind is a
# balance that changed with NO row saying why — the user's own repair for
# which, `adjustment`, is one of the same four branches. The adjustment case is
# also a real tightening: the server SETS the target inside the row lock and
# derives its own |delta| there instead of trusting a snapshot. Requires
# supabase-migration-p3-atomic-investments-and-single-leg.sql; with the flag on
# and the RPC missing every one of these entries fails with
# ATOMIC_SINGLE_LEG_UNAVAILABLE (deliberately loud).
# docs/server-side-money-engine.md §24-27
VITE_ATOMIC_SINGLE_LEG=

# Step 5b. Optional, OFF by default. Set to exactly `true` to route
# ACCOUNT-LINKED INVESTMENT TRADES (buy / sell / dividend) through the
# `record_investment_trade` RPC — one Postgres transaction for the balance leg,
# the investment_trades row and the transactions row. Positions in this product
# are DERIVED by replaying the trade ledger (there is no holdings table), so a
# drop between the balance and the trade row does not corrupt a figure, it
# DELETES the position: a wallet that paid for shares nobody holds, or sold
# shares that can be sold again. The server re-runs validateTradeInput and the
# full oversell replay. Requires the same migration; with the flag on and the
# RPC missing every account-linked trade fails with ATOMIC_INVEST_UNAVAILABLE.
# Trades "held outside Hisaab" (no account) never touch this path.
# Enable it AFTER VITE_ATOMIC_SINGLE_LEG has had its own release cycle.
VITE_ATOMIC_INVEST=

# ── Realtime transport for the money tables (audit P2 M2b / H5) ────────────
# Optional, OFF by default. Set to exactly `true` to move accounts /
# transactions / loans change signalling from `postgres_changes` to Supabase
# Realtime Broadcast on the private per-user topic `user:<uid>`. Anything else
# (including unset) keeps today's postgres_changes bindings.
# DO NOT set this until supabase-migration-p2-realtime-broadcast.sql is applied
# to the project this build talks to AND its check V1/V6 pass: with the flag on
# and the triggers missing, the money tables would go SILENTLY stale (no error,
# just no events) until the next resume refetch.
# Rollout, rollback and the publication-drop follow-up: docs/performance.md §6.4
VITE_REALTIME_BROADCAST=

# ── SQL-side analytics aggregates (audit P2 M2 / 03-performance H3) ────────
# Optional, OFF by default. Set to exactly `true` to serve the Analytics page's
# summary cards, currency chips and category pie from the
# `analytics_monthly_summary` RPC instead of summing the user's entire
# transaction history in the browser. Anything else (including unset) keeps
# today's client-side aggregation, byte for byte.
# Requires supabase-migration-p2-analytics-aggregates.sql. Unlike the flags
# above this one FAILS SOFT: if the RPC is missing (PGRST202) or the call fails,
# the page falls back to the client aggregation and reports the error — a
# finance app must never answer "how much did I spend" with a blank card.
# The daily chart, monthly trend and top-expenses list still aggregate
# client-side even with this on; see the migration header's "NOT PORTED".
# Rollout and what the Docker equality run proved: docs/performance.md §6.5
VITE_ANALYTICS_RPC=

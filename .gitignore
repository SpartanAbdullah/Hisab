# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code per-developer config (local permissions, machine paths)
.claude/

# Capacitor Android local/build output
android/.gradle/
android/.idea/
android/local.properties
android/**/build/
android/*.iml
*.apk
*.aab
*.jks
*.keystore

# Release signing — keystore + the passwords file that points to it.
# Both must NEVER be committed. See RELEASE.md for setup.
android/keystore.properties
android/app/*.jks
android/app/*.keystore

# Playwright (e2e/) — local run artifacts and the saved login session.
# e2e/.auth/*.json is a live Supabase storageState (session tokens) written by
# e2e/global-setup.ts — never committed, even for a staging-only account.
/test-results/

# 3D clay/color icon RAW sources (unoptimized originals downloaded from
# 3dicons.co / github.com/realvjy/3dicons, CC0). Deliberately NOT under
# public/ — Vite copies public/ verbatim into dist/, and these multi-
# hundred-KB originals must never ship to web or Android. Only the
# optimized WebP output (public/3d/*.webp), manifest.json and LICENSE.md
# are committed. Re-download originals into assets-src/3d-icons/<name>.png
# (default "color" style; "gradient" style sources live in
# assets-src/3d-icons/gradient/) and re-run `npm run build:3d`
# (scripts/build-3d-icons.mjs) to regenerate — see docs/design-system.md
# "3D icon assets".
assets-src/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/

# Firebase client config for the Android build — environment-specific, and this
# repo is public; each machine that builds a release downloads its own copy
# (docs/push-notifications-setup.md step 2-3).
android/app/google-services.json

# Firebase service-account private keys (downloaded from Project settings ->
# Service accounts). Real credentials: never in the repo, never in the bundle.
*firebase-adminsdk*.json
**/serviceAccountKey*.json
